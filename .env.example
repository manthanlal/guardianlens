# ============================================================
# GuardianLens — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit your real .env to GitHub
# ============================================================

# --- Microsoft Azure ---
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# --- Microsoft Foundry IQ ---
FOUNDRY_IQ_ENDPOINT=https://your-foundry-endpoint.azure.com
FOUNDRY_IQ_API_KEY=your-foundry-iq-api-key
FOUNDRY_IQ_PROJECT_NAME=guardianlens

# --- App Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- Safety Thresholds (0.0 to 1.0) ---
SAFETY_SCORE_THRESHOLD=0.65
PHISHING_SCORE_THRESHOLD=0.70
MINOR_PROTECTION_ENABLED=true
MIN_AGE_FOR_ADULT_CONTENT=18

# --- URL Scanning ---
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-key
VIRUSTOTAL_API_KEY=your-virustotal-api-key

# --- Report Generation ---
REPORT_OUTPUT_DIR=./reports
REPORT_LANGUAGE=en
